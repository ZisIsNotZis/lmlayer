# --- required ---
# PostgreSQL + pgvector DSN
DB=postgresql+asyncpg://root:root@127.0.0.1:5432/postgres

# Upstream OpenAI-compatible servers: JSON map name -> {cost, instances, embedding?, rerank?}
# lmlayer only speaks the OpenAI protocol, so any compatible server works
# (llama.cpp / llama-server, vLLM, SGLang, TGI, Ollama, ...).
MODEL={"qwen":{"cost":0,"instances":{"http://localhost:8080":1}},"qwenEmb":{"cost":0,"instances":{"http://localhost:8081":1},"embedding":true},"qwenRank":{"cost":0,"instances":{"http://localhost:8082":1},"rerank":true}}

# --- retrieval / RAG ---
EMBEDDING_DIM=1024
EMBEDDING=5
RERANK=2
CHUNK=1024
PROMPT=You are a helpful assistant
PROMPT_RAG={user}\n\nHere's some possibly related information: {RAG}

# --- safety ---
SAFE_MODEL=
SAFE_RE=炸弹
SAFE_PERIOD=50

# --- tools / scheduling ---
TOOL=python bash
PP_FAC=1.
TIME_FAC=0.5**(1/-3600)
